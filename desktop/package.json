    "@dnd-kit/utilities": "3.2.2",
    "@eslint/js": "10.0.1",
    "@fortune-sheet/core": "1.0.4",
    "@fortune-sheet/react": "1.0.4",
    "@git-diff-view/file": "0.1.7",
