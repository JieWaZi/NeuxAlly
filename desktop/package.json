{
  "name": "@neuxally/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json",
    "lint": "eslint .",
    "ui:check": "node ../scripts/check-ui-style-policy.mjs",
    "format": "prettier --write . ../package.json ../pnpm-workspace.yaml ../scripts/*.mjs ../scripts/*.cjs",
    "format:check": "prettier --check . ../package.json ../pnpm-workspace.yaml ../scripts/*.mjs ../scripts/*.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm ui:check && pnpm format:check && pnpm test && pnpm build && pnpm bundle:check && pnpm electron:build && pnpm electron:test",
    "bundle:check": "node ../scripts/check-desktop-entry-budget.mjs",
    "api:generate": "openapi-ts",
    "electron:build": "node ../scripts/build-electron.mjs",
    "electron:dev": "node ../scripts/dev-electron.mjs",
    "electron:test": "node --test electron/tests/*.test.mjs",
    "electron:package": "node ../scripts/package-desktop.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
