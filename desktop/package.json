    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "docx-preview": "^0.4.1",
    "dompurify": "3.4.11",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "globals": "17.8.0",
    "i18next": "26.3.6",
    "jsdom": "30.0.1",
    "lucide-react": "1.27.0",
    "motion": "12.43.0",
    "msw": "2.15.0",
    "papaparse": "5.5.3",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-i18next": "17.0.11",
    "react-router-dom": "7.18.2",
    "remotion": "4.0.533",
    "shiki": "3.23.0",
    "sonner": "2.0.8",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.neuxally.desktop",
    "productName": "NeuxAlly",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/node-pty/{src,typings,deps,third_party,scripts}/**/*",
      "!node_modules/node-pty/lib/*.test.js",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/node-pty/build/!(Release){,/**/*}",
      "!node_modules/node-pty/build/Release/!(*.node|*.dll|*.exe|spawn-helper|conpty){,/**/*}",
      "!node_modules/node-pty/build/Release/conpty/!(*.dll|*.exe){,/**/*}",
      "!node_modules/node-addon-api/!(LICENSE.md|package.json){,/**/*}",
      "!node_modules/node-pty/prebuilds/!(${platform}-${arch}){,/**/*}"
    ],
    "extraResources": [
      {
        "from": "resources/pi-bridge",
        "to": "pi-bridge",
        "filter": [
          "bridge.mjs",
          "MCP-LICENSES.txt"
        ]
      },
      {
        "from": "resources/plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "binaries",
        "to": "bin",
        "filter": [
          "ally-core",
          "ally-core.exe",
          "allycli",
          "allycli.exe"
        ]
      },
      {
        "from": "resources/tray/allyTemplate.png",
        "to": "tray/allyTemplate.png"
      },
      {
        "from": "resources/tray/allyTemplate@2x.png",
        "to": "tray/allyTemplate@2x.png"
      },
      {
        "from": "resources/tray/ally.ico",
        "to": "tray/ally.ico"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "identity": null,
      "minimumSystemVersion": "12.0"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis",
      "artifactName": "NeuxAlly-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "en-US",
      "zh-CN",
      "zh_CN"
    ]
  },
  "description": "NeuxAlly 本地伙伴工作台",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JieWaZi/NeuxAlly.git"
  }
}
